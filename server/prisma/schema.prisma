// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  nin          String   @unique
  email        String?  @unique
  passwordHash String?
  role         Role
  qrCode       String?   @unique @default(cuid())
  state        String?
  lga          String?
  schoolId     String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  school       School?  @relation(fields: [schoolId], references: [id])
  reports      SchoolReport[]
}

enum Role {
  NATIONAL_CMD
  STATE_CONTROL
  LGA_MONITOR
  SCHOOL_REPORTER
  VENDOR
  FARMER
  AGGREGATOR
}

model School {
  id            String   @id @default(cuid())
  name          String
  location      String
  needType      String   @default("General Education")
  description   String   @default("A school in need of support")
  image         String?
  targetAmount  Int      @default(100000)
  raisedAmount  Int      @default(0)
  studentCount  Int?     @default(0)
  state         String?
  lga           String?
  ward          String?
  town          String?
  specificLocation String?
  category      String?
  aggregator    String?
  originalNo    String?
  email         String?
  phone         String?
  address       String?
  principalName String?
  schoolType    String?  // Primary, Secondary, etc.
  needs         String[] @default(["Breakfast Programs", "Educational Materials"])
  isActive      Boolean  @default(true)
  qrCode        String?   @unique @default(cuid())
  importBatch   String?  // Track which import batch this school came from
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  donations     Donation[]
  breakfastDonations BreakfastDonation[]
  users         User[]
  reports       SchoolReport[]
}

model Vendor {
  id        String   @id @default(cuid())
  name      String
  category  String
  verified  Boolean  @default(false)
  nin       String?  @unique
  qrCode    String?   @unique @default(cuid())
  hygieneCertified Boolean @default(false)
  contact   String?
  portfolio String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Donation {
  id        String   @id @default(cuid())
  donorName String
  // For cash donations
  amount    Int?
  // For in-kind donations
  kindType  String?   // e.g., materials, services
  kindDesc  String?
  imageUrl  String?
  type      DonationType
  date      DateTime @default(now())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
}

enum DonationType {
  CASH
  IN_KIND
}

model Company {
  id               String    @id @default(cuid())
  name             String
  logo             String?
  description      String?
  supportedCauses  String[]  // array of strings
  partnershipType  String?   // one-time donor, recurring partner, etc.
  contact          String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Supplier {
  id              String   @id @default(cuid())
  name            String
  logo            String?
  description     String?
  specialties     String[] // array of specialties like ["Biscuits", "Juices", "Cereals"]
  rating          Float    @default(0)
  deliveryAreas   String[] // array of delivery areas
  accountDetails  Json     // bank account details
  contactInfo     Json     // phone, email
  verified        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  breakfastDonations BreakfastDonation[]
}

model BreakfastDonation {
  id              String   @id @default(cuid())
  donorName       String
  schoolId        String
  supplierId      String
  selectedWeeks   String[] // array of week IDs
  totalAmount     Int
  costPerStudent  Int      @default(50)
  studentCount    Int
  paymentConfirmed Boolean @default(false)
  paymentReference String?
  status          DonationStatus @default(PENDING)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  school          School   @relation(fields: [schoolId], references: [id])
  supplier        Supplier @relation(fields: [supplierId], references: [id])
}

enum DonationStatus {
  PENDING
  PAYMENT_CONFIRMED
  SUPPLIER_NOTIFIED
  IN_PROGRESS
  DELIVERED
  COMPLETED
  CANCELLED
}

// Operational Blueprint Additional Models

model SchoolReport {
  id                String   @id @default(cuid())
  schoolId          String
  date              DateTime @default(now())
  pupilsFedToday    Int      @default(0)
  menuServed        String?
  vendorName        String?
  qualityScore      Int?      @default(5)
  reportedByUserId  String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  school            School   @relation(fields: [schoolId], references: [id])
  reporter          User?    @relation(fields: [reportedByUserId], references: [id])
}

model FoodSupply {
  id             String   @id @default(cuid())
  product        String
  quantity       Float
  unit           String   @default("units")
  state          String
  sourceId       String?
  destinationId  String?
  status         String   @default("In Transit")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model FinancialRecord {
  id          String   @id @default(cuid())
  category    String   // Food procurement, Vendor payments, Logistics, Monitoring
  amount      Float
  description String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SafetyReport {
  id          String   @id @default(cuid())
  type        String   // inspection, spoiled_food, complaint
  description String
  status      String   @default("Pending")
  targetId    String?  // Could refer to vendorId or schoolId dynamically
  reportedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ImpactMetric {
  id            String   @id @default(cuid())
  indicatorName String
  valueType     String   // percentage, count, etc.
  currentValue  Float
  trend         String?  // increase, reduction
  measuredAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
