// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  name           String
  nin            String?  @unique
  email          String?  @unique
  passwordHash   String?
  role           Role
  qrCode         String?  @unique @default(cuid())
  state          String?
  lga            String?
  schoolId       String?
  isActive       Boolean  @default(true)
  
  // Supplier Specific Fields
  companyName    String?
  accountDetails Json?
  contactInfo    Json?    // phone, email, etc.

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  school         School?  @relation(fields: [schoolId], references: [id])
  reports        SchoolReport[]
  
  donorRequests    SupplyRequest[] @relation("DonorRequests")
  supplierRequests SupplyRequest[] @relation("SupplierRequests")
}

enum Role {
  ADMIN
  SUPPLIER
  VERIFIER
  DONOR
}

model School {
  id            String   @id @default(cuid())
  name          String
  location      String
  needType      String   @default("General Education")
  description   String   @default("A school in need of support")
  image         String?
  targetAmount  Int      @default(100000)
  raisedAmount  Int      @default(0)
  studentCount  Int?     @default(0)
  state         String?
  lga           String?
  ward          String?
  town          String?
  specificLocation String?
  category      String?
  aggregator    String?
  originalNo    String?
  email         String?
  phone         String?
  address       String?
  principalName String?
  schoolType    String?  // Primary, Secondary, etc.
  needs         String[] @default(["Breakfast Programs", "Educational Materials"])
  isActive      Boolean  @default(true)
  qrCode        String?   @unique @default(cuid())
  importBatch   String?  // Track which import batch this school came from
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  users         User[]
  reports       SchoolReport[]
  supplyRequests SupplyRequest[]
}

model SupplyRequest {
  id              String   @id @default(cuid())
  donorId         String
  schoolId        String
  supplierId      String
  academicPeriod  String
  supplyDate      String?
  items           Json     // Array of items and quantities
  status          RequestStatus @default(PENDING_PAYMENT)
  proofImageUrl   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  donor           User     @relation("DonorRequests", fields: [donorId], references: [id])
  school          School   @relation(fields: [schoolId], references: [id])
  supplier        User     @relation("SupplierRequests", fields: [supplierId], references: [id])
}

enum RequestStatus {
  PENDING_PAYMENT
  PAYMENT_CLAIMED
  PAYMENT_CONFIRMED
  DELIVERED
  VERIFIED
}

model SchoolReport {
  id                String   @id @default(cuid())
  schoolId          String
  date              DateTime @default(now())
  pupilsFedToday    Int      @default(0)
  menuServed        String?
  vendorName        String?
  qualityScore      Int?      @default(5)
  evidenceUrl       String?
  reportedByUserId  String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  school            School   @relation(fields: [schoolId], references: [id])
  reporter          User?    @relation(fields: [reportedByUserId], references: [id])
}
